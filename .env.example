# Copy to .env (or set as environment variables / IntelliJ Run Configuration).

# Database (defaults match docker-compose.yml)
DB_URL=jdbc:mysql://localhost:3306/jobsearch?createDatabaseIfNotExist=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=jobsearch
DB_PASSWORD=jobsearch

# Allowed frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:5173

# Optional job sources. Without these keys, Adzuna and Jooble are switched off.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
